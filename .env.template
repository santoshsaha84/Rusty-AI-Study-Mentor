# Copy this file to .env and fill in values
# NEVER commit .env to git

# ── Local dev Postgres ──────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://rusty:localdev@localhost:5432/rusty_dev

# ── Firebase emulator (leave blank for production) ──────────────────────────
FIREBASE_AUTH_EMULATOR_HOST=localhost:9099
FIRESTORE_EMULATOR_HOST=localhost:8080
FIREBASE_PROJECT_ID=demo-rusty

# ── GCP / Vertex AI (real creds needed even for local dev) ──────────────────
GOOGLE_APPLICATION_CREDENTIALS=./service-account-dev.json
VERTEX_AI_PROJECT=your-gcp-project-id
VERTEX_AI_LOCATION=global
VERTEX_EMBED_MODEL=gemini-embedding-001

# ── Gemini ───────────────────────────────────────────────────────────────────
GEMINI_MODEL=gemini-3.1-flash-lite

# ── Safeguarding ─────────────────────────────────────────────────────────────
SAFEGUARDING_ALERT_EMAIL=diksha-safeguarding@example.com
PHRASES_FILE_PATH=./safeguarding/phrases_v1.json

# ── App ──────────────────────────────────────────────────────────────────────
APP_ENV=development
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_ME_generate_a_real_secret

# ── CORS allowed origins (comma-separated) ───────────────────────────────────
ALLOWED_ORIGINS=http://localhost:5173
