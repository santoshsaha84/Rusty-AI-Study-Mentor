# PRODUCTION config for GCP — copy to backend/.env.production and replace every <...> placeholder.
# The real file is gitignored.
#
# Used two ways:
#   1. deploy/deploy.sh production -> sends these as Cloud Run env vars (API + jobs).
#      SECRET keys below are never sent as env vars; they come from Secret Manager.
#   2. Running the backend/ingestion locally against production: set APP_ENV=production in your
#      shell (selects this file) and put the secrets in your shell or in this file.
#
# The app refuses to start outside development while any value still holds a placeholder.

APP_ENV=production

# ── Secrets: from Secret Manager on Cloud Run (DEPLOY_SECRETS below) ─────────
# DATABASE_URL=postgresql+asyncpg://rusty_app:<DB_PASSWORD>@/rusty?host=/cloudsql/<PROJECT_ID>:asia-south1:rusty-db
# SECRET_KEY=<python -c "import secrets; print(secrets.token_hex(32))">
# GEMINI_API_KEY=<only when GEMINI_AUTH=api_key>
# SMTP_PASSWORD=<relay password>

# ── Database pool: (POOL + OVERFLOW) x WEB_CONCURRENCY x max instances < max_connections
DB_POOL_SIZE=3
DB_MAX_OVERFLOW=2

# ── LLM: Gemini via google-genai ─────────────────────────────────────────────
LLM_PROVIDER=vertex
# adc = Vertex AI with the Cloud Run service account (recommended, no key to rotate)
# api_key = Gemini API key from Secret Manager (add GEMINI_API_KEY to DEPLOY_SECRETS)
GEMINI_AUTH=adc
VERTEX_AI_PROJECT=<PROJECT_ID>
# global = cost option (prompts may be processed outside India).
# India-resident option: VERTEX_AI_LOCATION=asia-south1 and GEMINI_MODEL=gemini-3.5-flash
VERTEX_AI_LOCATION=global
GEMINI_MODEL=<GEMINI_MODEL e.g. gemini-3.1-flash-lite>
VERTEX_EMBED_MODEL=<EMBED_MODEL e.g. gemini-embedding-001>
# Must match the pgvector column (vector(1024)); the embed call requests this many dims.
EMBED_DIM=1024

# ── Firebase (real project — emulator hosts must stay unset) ─────────────────
FIREBASE_PROJECT_ID=<PROJECT_ID>

# ── GCP infrastructure ───────────────────────────────────────────────────────
GCP_PROJECT_ID=<PROJECT_ID>
GCP_REGION=asia-south1
TEXTBOOK_BUCKET=<PROJECT_ID>-textbooks
INGEST_JOB_NAME=rusty-ingest

# ── Safeguarding ─────────────────────────────────────────────────────────────
SAFEGUARDING_ALERT_EMAIL=<SAFEGUARDING_ROLE_MAILBOX>
PHRASES_FILE_PATH=./safeguarding/phrases_v1.json
SMTP_HOST=<SMTP_RELAY_HOST>
SMTP_PORT=587
SMTP_USERNAME=<SMTP_USERNAME>
SMTP_FROM=<SENDER_ADDRESS>

# ── CORS: the Firebase Hosting origins (no wildcard) ─────────────────────────
ALLOWED_ORIGINS=https://<PROJECT_ID>.web.app,https://<PROJECT_ID>.firebaseapp.com

# ── Deploy-only settings (read by deploy/deploy.sh, ignored by the app) ──────
# Defaults in deploy.sh follow doc/GCP_DEPLOYMENT_PLAN.md naming; override here if yours differ.
DEPLOY_SQL_INSTANCE=<PROJECT_ID>:asia-south1:rusty-db
DEPLOY_IMAGE=asia-south1-docker.pkg.dev/<PROJECT_ID>/rusty/api
DEPLOY_API_SERVICE=rusty-api
DEPLOY_API_SA=rusty-api@<PROJECT_ID>.iam.gserviceaccount.com
DEPLOY_JOBS_SA=rusty-jobs@<PROJECT_ID>.iam.gserviceaccount.com
# 1 keeps an instance warm (no cold starts) at an idle cost; 0 to save money.
DEPLOY_MIN_INSTANCES=1
DEPLOY_MAX_INSTANCES=4
DEPLOY_WEB_CONCURRENCY=2
# ENV_VAR=SECRET_NAME:VERSION pairs, comma-separated. Add GEMINI_API_KEY=GEMINI_API_KEY:latest
# for GEMINI_AUTH=api_key, and SMTP_PASSWORD=SMTP_PASSWORD:latest once alert email is wired up.
DEPLOY_SECRETS=DATABASE_URL=DATABASE_URL:latest,SECRET_KEY=SECRET_KEY:latest
