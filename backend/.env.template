# LOCAL DEVELOPMENT config — copy to backend/.env (never commit it).
# APP_ENV picks the env file: development -> .env (this), staging -> .env.staging,
# production -> .env.production (see .env.staging.template / .env.production.template).
APP_ENV=development
SECRET_KEY=change-me-to-a-random-string

# Database (Docker pgvector)
DATABASE_URL=postgresql+asyncpg://rusty:localdev@localhost:5432/rusty_dev

# LLM Provider: "ollama" for local dev, "vertex" for Gemini on GCP
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_EMBED_MODEL=snowflake-arctic-embed2

# Gemini (not used when LLM_PROVIDER=ollama)
# GEMINI_AUTH=adc uses Application Default Credentials (`gcloud auth application-default login`
# locally, the service account on Cloud Run); GEMINI_AUTH=api_key uses GEMINI_API_KEY.
# Switching provider changes the embedding space — re-ingest all PDFs.
GEMINI_AUTH=adc
# GEMINI_API_KEY=
VERTEX_AI_PROJECT=your-gcp-project
VERTEX_AI_LOCATION=global
GEMINI_MODEL=gemini-3.1-flash-lite
VERTEX_EMBED_MODEL=gemini-embedding-001

# Firebase emulators
FIREBASE_PROJECT_ID=demo-rusty
FIREBASE_AUTH_EMULATOR_HOST=localhost:9099
FIRESTORE_EMULATOR_HOST=localhost:8080

# Safeguarding
SAFEGUARDING_ALERT_EMAIL=admin@example.com
PHRASES_FILE_PATH=./safeguarding/phrases_v1.json

# CORS
ALLOWED_ORIGINS=http://localhost:5173

# Leave TEXTBOOK_BUCKET unset locally: PDFs are ingested in-process with Ollama.
