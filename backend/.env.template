APP_ENV=development
SECRET_KEY=change-me-to-a-random-string

# Database (Docker pgvector)
DATABASE_URL=postgresql+asyncpg://rusty:localdev@localhost:5432/rusty_dev

# LLM Provider: "ollama" for local dev, "vertex" for production
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_EMBED_MODEL=snowflake-arctic-embed2

# Vertex AI / Gemini (not used when LLM_PROVIDER=ollama)
# Auth uses Application Default Credentials: `gcloud auth application-default login` locally,
# the service account on Cloud Run. Switching provider changes the embedding space — re-ingest all PDFs.
VERTEX_AI_PROJECT=your-gcp-project
VERTEX_AI_LOCATION=global
GEMINI_MODEL=gemini-3.1-flash-lite
VERTEX_EMBED_MODEL=gemini-embedding-001

# Firebase emulators
FIREBASE_PROJECT_ID=demo-rusty
FIREBASE_AUTH_EMULATOR_HOST=localhost:9099
FIRESTORE_EMULATOR_HOST=localhost:8080

# Safeguarding
SAFEGUARDING_ALERT_EMAIL=admin@example.com
PHRASES_FILE_PATH=./safeguarding/phrases_v1.json

# CORS
ALLOWED_ORIGINS=http://localhost:5173
